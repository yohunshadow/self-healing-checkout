# Non-secret fixer config. Copy to .env (git-ignored). The API key is read ONLY from the environment:
#   export FIXER_API_KEY=...   (never commit it)
FIXER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FIXER_MODEL=gemini-3.8-flash
FIXER_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
