# Non-secret fixer config. Copy to .env (git-ignored). The API key is read ONLY from the environment:
#   export FIXER_API_KEY=...   (never commit it)
FIXER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FIXER_MODEL=gemini-3.8-flash
FIXER_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
# Optional second provider, used when every primary model fails (e.g. Gemini 503 high demand).
# The key is read from the env var named in FIXER2_KEY_ENV (never commit it).
FIXER2_BASE_URL=https://integrate.api.nvidia.com/v1
FIXER2_KEY_ENV=NVIDIA_API_KEY
FIXER2_MODELS=mistralai/mistral-large-4-1t-a52b,minimaxai/minimax-m3.1-flash
